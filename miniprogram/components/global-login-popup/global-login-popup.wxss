.login-mask {
  position: fixed;
  z-index: 9999;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(16, 24, 32, 0.68);
  box-sizing: border-box;
}

.login-dialog {
  width: 100%;
  max-width: 620rpx;
  padding: 44rpx 36rpx 36rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.22);
  box-sizing: border-box;
  text-align: center;
}

.brand-mark {
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #0b7a75;
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 104rpx;
}

.login-title {
  display: block;
  color: #101820;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.25;
}

.login-desc {
  display: block;
  margin: 18rpx 0 34rpx;
  color: #68717d;
  font-size: 28rpx;
  line-height: 1.55;
}

.login-button {
  width: 100%;
  height: 88rpx;
  border-radius: 12rpx;
  background: #0b7a75;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.login-button::after {
  border: 0;
}
