<view wx:if="{{visible}}" class="login-mask" catchtouchmove="noop">
  <view class="login-dialog">
    <view class="brand-mark">球</view>
    <text class="login-title">微信一键登录</text>
    <text class="login-desc">先体验浏览功能，再在需要时选择微信登录，登录后可保存预测记录并同步昵称头像。</text>
    <button class="login-button" loading="{{loading}}" bindtap="handleLogin">
      {{loading ? "登录中" : "微信一键登录"}}
    </button>
  </view>
</view>
