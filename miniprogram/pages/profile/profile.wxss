.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 38rpx 28rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border-radius: 999rpx;
  background: #17212b;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 900;
}

.avatar-img {
  width: 108rpx;
  height: 108rpx;
  border-radius: 999rpx;
  background: #eef2f5;
}

.profile-avatar-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  min-width: 108rpx;
  max-width: 108rpx;
  height: 108rpx;
  min-height: 108rpx;
  max-height: 108rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #eef2f5;
  overflow: hidden;
  line-height: 108rpx;
}

.profile-avatar-button::after {
  border: 0;
}

.name {
  margin: 18rpx 0 8rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.profile-name-input {
  width: 360rpx;
  height: 48rpx;
  margin: 18rpx 0 8rpx;
  color: #17212b;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 48rpx;
  text-align: center;
}

.profile-sync-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 260rpx;
  height: 64rpx;
  margin-top: 18rpx;
  padding: 0 26rpx;
  border-radius: 8rpx;
  background: #0b7a75;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 18rpx rgba(11, 122, 117, 0.2);
}

.title-badge {
  margin-bottom: 10rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #e8f4f3;
  color: #0b7a75;
  font-size: 22rpx;
  font-weight: 900;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.stat {
  padding: 24rpx 12rpx;
  text-align: center;
}

.stat-value {
  display: block;
  margin-bottom: 8rpx;
  color: #0b7a75;
  font-size: 34rpx;
  font-weight: 900;
}

.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  margin-bottom: 16rpx;
  padding: 0 24rpx;
  font-weight: 800;
}

.login-card {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 24rpx;
  padding: 26rpx;
}

.login-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.login-desc {
  display: block;
  color: #68717d;
  font-size: 25rpx;
  line-height: 1.5;
}

.login-btn {
  width: 100%;
}

.link-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  height: 58rpx;
  padding: 0 18rpx;
  background: #ffffff;
  color: #0b7a75;
  font-size: 25rpx;
  font-weight: 800;
}

.badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.badge {
  padding: 12rpx 18rpx;
  border-radius: 8rpx;
  background: #17212b;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
}
