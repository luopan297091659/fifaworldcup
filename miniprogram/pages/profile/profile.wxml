<view class="page">
  <view class="card profile-card">
    <button wx:if="{{isLoggedIn}}" class="profile-avatar-button" open-type="chooseAvatar" plain="true" hover-class="none" bindchooseavatar="handleChooseAvatar">
      <image wx:if="{{profileForm.avatarUrl || me.avatarUrl}}" class="avatar-img" src="{{profileForm.avatarUrl || me.avatarUrl}}" mode="aspectFill"></image>
      <text wx:else class="avatar">我</text>
    </button>
    <block wx:else>
      <image wx:if="{{me.avatarUrl || profileForm.avatarUrl}}" class="avatar-img" src="{{me.avatarUrl || profileForm.avatarUrl}}" mode="aspectFill"></image>
      <text wx:else class="avatar">{{me.name || me.displayName || '我'}}</text>
    </block>

    <input
      wx:if="{{isLoggedIn}}"
      class="profile-name-input"
      type="nickname"
      placeholder="点击选择微信昵称"
      value="{{profileForm.name}}"
      maxlength="32"
      confirm-type="done"
      bindinput="handleNicknameInput"
      bindblur="handleNicknameInput"
      bindconfirm="handleNicknameInput"
    />
    <text wx:else class="name">{{me.name || me.displayName || '我'}}</text>
    <text class="title-badge">{{me.title}}</text>
    <text class="muted">预测 {{me.predictions}} 场 · AI 对照 {{me.aiWins}} 次</text>
    <button wx:if="{{isLoggedIn}}" class="profile-sync-btn" loading="{{profileSaving}}" bindtap="handleSyncWechatProfile">
      {{profileSaving ? "保存中" : (profileNeedsSync ? "确认同步头像昵称" : "更新头像昵称")}}
    </button>
  </view>

  <view wx:if="{{!isLoggedIn}}" class="card login-card">
    <view>
      <text class="login-title">微信登录</text>
      <text class="login-desc">登录后可同步昵称与头像，并为正式服务端保存预测记录。</text>
    </view>
    <button class="primary-btn login-btn" loading="{{loginLoading}}" bindtap="handleWechatLogin">
      {{loginLoading ? "登录中" : "微信一键登录"}}
    </button>
  </view>
  <view wx:else class="card action-row">
    <text>{{profileNeedsSync ? '已登录，请同步头像/昵称' : '已登录并同步头像/昵称'}}</text>
    <button class="link-btn" bindtap="handleLogout">退出</button>
  </view>

  <view class="stats">
    <view class="card stat">
      <text class="stat-value">{{me.score}}</text>
      <text class="muted">总积分</text>
    </view>
    <view class="card stat">
      <text class="stat-value">{{aiStats.userWinRate}}%</text>
      <text class="muted">用户胜率</text>
    </view>
    <view class="card stat">
      <text class="stat-value">{{aiStats.aiWinRate}}%</text>
      <text class="muted">AI 胜率</text>
    </view>
  </view>

  <view class="section-title">我的徽章</view>
  <view class="badges">
    <view class="badge" wx:for="{{me.badges}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="card action-row">
    <text>预测记录仅作娱乐展示</text>
    <text class="muted">无兑换功能</text>
  </view>
</view>
