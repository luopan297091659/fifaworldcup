<view class="page">
  <view class="card profile-card">
    <image wx:if="{{me.avatarUrl}}" class="avatar-img" src="{{me.avatarUrl}}" mode="aspectFill"></image>
    <text wx:else class="avatar">我</text>
    <text class="name">{{me.name}}</text>
    <text class="title-badge">{{me.title}}</text>
    <text class="muted">预测 {{me.predictions}} 场 · AI 对照 {{me.aiWins}} 次</text>
  </view>

  <view wx:if="{{!isLoggedIn}}" class="card login-card">
    <view>
      <text class="login-title">微信登录</text>
      <text class="login-desc">登录后可同步昵称头像，并为正式服务端保存预测记录。</text>
    </view>
    <button class="primary-btn login-btn" loading="{{loginLoading}}" bindtap="handleWechatLogin">
      {{loginLoading ? "登录中" : "微信一键登录"}}
    </button>
  </view>
  <view wx:else class="card action-row">
    <text>已登录微信账号</text>
    <button class="link-btn" bindtap="handleLogout">退出</button>
  </view>

  <view wx:if="{{isLoggedIn}}" class="card profile-sync-card">
    <view class="sync-head">
      <text class="login-title">同步微信资料</text>
      <text class="login-desc">保存后昵称头像会同步到个人页和排行榜。</text>
    </view>
    <view class="profile-form">
      <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="handleChooseAvatar">
        <image wx:if="{{profileForm.avatarUrl}}" class="avatar-img" src="{{profileForm.avatarUrl}}" mode="aspectFill"></image>
        <text wx:else class="avatar">我</text>
      </button>
      <input
        class="nickname-input"
        type="nickname"
        value="{{profileForm.name}}"
        placeholder="填写微信昵称"
        bindinput="handleNicknameInput"
      />
    </view>
    <button class="primary-btn login-btn" loading="{{profileSaving}}" bindtap="handleSyncWechatProfile">
      {{profileSaving ? "同步中" : "同步昵称头像"}}
    </button>
  </view>

  <view class="stats">
    <view class="card stat">
      <text class="stat-value">{{me.score}}</text>
      <text class="muted">总积分</text>
    </view>
    <view class="card stat">
      <text class="stat-value">{{aiStats.userWinRate}}%</text>
      <text class="muted">用户胜率</text>
    </view>
    <view class="card stat">
      <text class="stat-value">{{aiStats.aiWinRate}}%</text>
      <text class="muted">AI 胜率</text>
    </view>
  </view>

  <view class="section-title">我的徽章</view>
  <view class="badges">
    <view class="badge" wx:for="{{me.badges}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="card action-row">
    <text>预测记录仅作娱乐展示</text>
    <text class="muted">无兑换功能</text>
  </view>
</view>
