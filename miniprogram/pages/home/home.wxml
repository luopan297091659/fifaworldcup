<view class="page">
  <view class="hero home-hero">
    <image wx:if="{{heroImageUrl}}" class="hero-bg" src="{{heroImageUrl}}" mode="aspectFill"></image>
    <view class="hero-shade"></view>
    <view class="hero-content">
      <text class="hero-title">球见未来</text>
      <text class="hero-subtitle">{{opening.openingText || "2026 世界杯开幕战"}} · {{opening.openingMatch || "墨西哥 vs 南非"}}</text>
      <text class="hero-meta">{{opening.openingVenue || "Mexico City Stadium"}}</text>

      <view class="countdown">
        <view class="countdown-item">
          <text class="countdown-value">{{countdown.days}}</text>
          <text class="countdown-label">天</text>
        </view>
        <view class="countdown-item">
          <text class="countdown-value">{{countdown.hours}}</text>
          <text class="countdown-label">时</text>
        </view>
        <view class="countdown-item">
          <text class="countdown-value">{{countdown.minutes}}</text>
          <text class="countdown-label">分</text>
        </view>
        <view class="countdown-item">
          <text class="countdown-value">{{countdown.seconds}}</text>
          <text class="countdown-label">秒</text>
        </view>
      </view>

      <view class="hero-stats">
        <view>
          <text class="stat-value">{{me.score || 0}}</text>
          <text class="stat-label">我的积分</text>
        </view>
        <view>
          <text class="stat-value">{{me.aiWins || 0}}</text>
          <text class="stat-label">赢过 AI</text>
        </view>
        <view>
          <text class="stat-value">{{me.percentile || 0}}%</text>
          <text class="stat-label">超过玩家</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section-title">近期比赛</view>
  <view class="match-list" wx:if="{{matches.length}}">
    <view class="card match-card" wx:for="{{matches}}" wx:key="id" bindtap="goPredict" data-id="{{item.id}}">
      <view class="match-head">
        <text class="tag">{{item.group}}</text>
        <text class="muted">{{item.time}}</text>
      </view>
      <view class="teams">
        <text>{{item.home}}</text>
        <text class="versus">VS</text>
        <text>{{item.away}}</text>
      </view>
      <view class="match-foot">
        <text class="muted">{{item.aiSummary}}</text>
        <text class="{{item.status === 'closed' ? 'status closed' : 'status'}}">{{item.statusText}}</text>
      </view>
    </view>
  </view>
  <view class="card empty-card" wx:else>
    <text>暂无线上比赛数据</text>
  </view>

  <view class="section-title">公开群动态</view>
  <view class="match-list" wx:if="{{groups.length}}">
    <view class="card match-card group-card" wx:for="{{groups}}" wx:key="id">
      <view class="group-card-top">
        <view class="group-card-header">
          <text class="tag">{{item.status || '活跃'}}</text>
          <text class="group-card-title">{{item.name}}</text>
        </view>
        <text class="muted">热度 {{item.heat || 0}}</text>
      </view>

      <view class="group-card-body">
        <text class="muted">{{item.memberCount || 0}} 人在线 · {{item.accessMode || '公开群'}}</text>
        <text class="group-card-desc" wx:if="{{item.shareText || item.description}}">{{item.shareText || item.description}}</text>
      </view>

      <view class="group-action-row">
        <button class="mini-action-btn" open-type="share" data-name="{{item.name}}" data-room-id="{{item.id}}">邀请加入</button>
        <button class="mini-action-btn" bindtap="joinPublicGroup" data-room-id="{{item.id}}" wx:if="{{!item.joined}}">立即加入</button>
        <button class="mini-action-btn" bindtap="goRanking">积分排名</button>
        <button class="mini-action-btn" bindtap="goLive" data-room-id="{{item.id}}" data-name="{{item.name}}">预测实况</button>
      </view>
    </view>
  </view>
  <view class="card empty-card" wx:else>
    <text>暂无群组信息</text>
  </view>

  <view class="section-title">最新比赛</view>
  <view class="match-list" wx:if="{{latestMatches.length}}">
    <view class="card match-card" wx:for="{{latestMatches}}" wx:key="id">
      <view class="match-head">
        <text class="tag">{{item.group || '最新比赛'}}</text>
        <text class="muted">{{item.time || '即将开赛'}}</text>
      </view>
      <view class="teams">
        <text>{{item.home}}</text>
        <text class="versus">VS</text>
        <text>{{item.away}}</text>
      </view>
      <view class="match-foot">
        <text class="muted">{{item.venue || '赛事场馆'}}</text>
        <text class="status">{{item.status === 'closed' ? '已公布' : '待开赛'}}</text>
      </view>
    </view>
  </view>
  <view class="card empty-card" wx:else>
    <text>暂无最新比赛信息</text>
  </view>

  <view class="section-title">好友小组</view>
  <view class="card room-preview" wx:if="{{topRoom}}" bindtap="goRoom">
    <view>
      <text class="room-name">{{topRoom.name}}</text>
      <text class="muted">{{topRoom.members}} 人正在预测</text>
    </view>
    <text class="rank-badge">第 {{myRoomRank}} 名</text>
  </view>
  <view class="card room-preview empty-room" wx:else bindtap="goRoom">
    <view>
      <text class="room-name">还没有小组</text>
      <text class="muted">创建线上小组后会在这里展示</text>
    </view>
    <text class="rank-badge">去创建</text>
  </view>
</view>
