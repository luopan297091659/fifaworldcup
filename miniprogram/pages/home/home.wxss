.home-hero {
  position: relative;
  min-height: 560rpx;
  overflow: hidden;
  padding: 0;
  background: #101820;
}

.hero-bg,
.hero-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-shade {
  background: linear-gradient(180deg, rgba(16, 24, 32, 0.22), rgba(16, 24, 32, 0.86));
}

.hero-content {
  position: relative;
  z-index: 2;
  min-height: 560rpx;
  padding: 64rpx 32rpx 36rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.hero-title,
.hero-subtitle,
.hero-meta {
  position: relative;
  z-index: 2;
}

.hero-meta {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
}

.countdown {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-top: 30rpx;
}

.countdown-item {
  min-height: 104rpx;
  padding: 16rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.15);
  text-align: center;
}

.countdown-value,
.countdown-label,
.stat-value,
.stat-label {
  display: block;
}

.countdown-value {
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.1;
}

.countdown-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.hero-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 18rpx;
}

.hero-stats view {
  padding: 18rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.12);
}

.stat-value {
  font-size: 34rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.match-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.match-card,
.empty-card {
  padding: 26rpx;
}

.match-head,
.match-foot,
.room-preview {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.teams {
  display: grid;
  grid-template-columns: 1fr 80rpx 1fr;
  align-items: center;
  margin: 28rpx 0;
  font-size: 36rpx;
  font-weight: 800;
  text-align: center;
}

.versus {
  color: #8a949f;
  font-size: 22rpx;
  font-weight: 800;
}

.status {
  color: #0b7a75;
  font-size: 24rpx;
  font-weight: 800;
}

.status.closed {
  color: #b64128;
}

.room-preview {
  padding: 26rpx;
}

.room-name {
  display: block;
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.rank-badge {
  min-width: 110rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  background: #17212b;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.empty-room .rank-badge {
  background: #0b7a75;
}
