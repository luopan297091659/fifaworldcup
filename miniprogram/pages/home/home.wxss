.home-hero {
  position: relative;
  min-height: 600rpx;
  overflow: hidden;
  padding: 0;
  border-radius: 28rpx;
  background: transparent;
}

.hero-bg,
.hero-shade {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hero-bg {
  top: 18rpx;
  height: calc(100% + 36rpx);
  object-position: center top;
  pointer-events: none;
}

.hero-shade {
  background: linear-gradient(180deg,
    rgba(7, 12, 18, 0.18) 0%,
    rgba(7, 12, 18, 0.42) 38%,
    rgba(5, 9, 14, 0.72) 100%);
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 1;
  min-height: 560rpx;
  padding: 68rpx 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.hero-title,
.hero-subtitle,
.hero-meta {
  position: relative;
  z-index: 2;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(5, 9, 14, 0.55);
}

.hero-meta {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
}

.live-result-card {
  margin-top: 28rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 18rpx;
  background: rgba(8, 12, 18, 0.46);
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.18);
}

.live-result-head,
.live-score-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.live-pill {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0b7a75;
  font-size: 22rpx;
  font-weight: 900;
}

.live-time,
.live-report {
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
}

.live-score-row {
  margin-top: 18rpx;
}

.live-team {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
  text-align: center;
}

.live-score {
  min-width: 112rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.1;
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(5, 9, 14, 0.55);
}

.live-report {
  display: block;
  margin-top: 14rpx;
  line-height: 1.4;
}

.stat-value,
.stat-label {
  display: block;
}

.hero-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.hero-stats view {
  padding: 16rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 18rpx;
  background: rgba(8, 12, 18, 0.42);
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.18);
}

.stat-value {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  text-shadow: 0 2rpx 8rpx rgba(5, 9, 14, 0.55);
}

.stat-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
}

.match-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.match-card,
.empty-card {
  padding: 22rpx;
}

.group-card {
  border: 2rpx solid #e7edf3;
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
}

.group-card-top,
.group-card-body {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.group-card-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.group-card-title {
  color: #17212b;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
}

.group-card-meta {
  display: block;
  color: #5f6b78;
  font-size: 22rpx;
  line-height: 1.35;
}

.group-card-desc {
  color: #304253;
  font-size: 24rpx;
  line-height: 1.45;
}

.group-card-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 2rpx;
}

.group-action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin-top: 14rpx;
}

.group-action-row.joined {
  grid-template-columns: 1fr;
}

.mini-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  padding: 0 14rpx;
  border: 2rpx solid #d2dae3;
  border-radius: 999rpx;
  background: #ffffff;
  color: #17212b;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
}

.mini-action-btn.primary {
  border-color: #0b7a75;
  background: #0b7a75;
  color: #ffffff;
}

.group-feed {
  margin-top: 14rpx;
  padding: 12rpx;
  border-radius: 14rpx;
  background: #f4f7fb;
}

.feed-item {
  margin-top: 6rpx;
  color: #304253;
  font-size: 24rpx;
  line-height: 1.45;
}

.group-note {
  display: block;
  margin-top: 10rpx;
  color: #68717d;
  font-size: 22rpx;
  line-height: 1.4;
}

.match-head,
.match-foot,
.room-preview {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.teams {
  display: grid;
  grid-template-columns: 1fr 80rpx 1fr;
  align-items: center;
  margin: 18rpx 0 14rpx;
  font-size: 36rpx;
  font-weight: 800;
  text-align: center;
}

.versus {
  color: #8a949f;
  font-size: 22rpx;
  font-weight: 800;
}

.status {
  color: #0b7a75;
  font-size: 24rpx;
  font-weight: 800;
}

.status.closed {
  color: #b64128;
}

.prediction-record {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  border: 2rpx solid rgba(11, 122, 117, 0.18);
  border-radius: 10rpx;
  background: #f0faf8;
}

.prediction-label {
  flex: 0 0 auto;
  color: #0b7a75;
  font-size: 22rpx;
  font-weight: 900;
}

.prediction-text {
  min-width: 0;
  color: #17212b;
  font-size: 24rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.room-preview {
  padding: 20rpx;
}

.room-name {
  display: block;
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.rank-badge {
  min-width: 110rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  background: #17212b;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.empty-room .rank-badge {
  background: #0b7a75;
}
