.match-panel {
  padding: 28rpx;
}

.time {
  display: block;
  margin-top: 18rpx;
  color: #68717d;
}

.teams {
  display: grid;
  grid-template-columns: 1fr 80rpx 1fr;
  align-items: center;
  margin: 30rpx 0 16rpx;
  font-size: 38rpx;
  font-weight: 800;
  text-align: center;
}

.versus {
  color: #8a949f;
  font-size: 22rpx;
}

.segmented {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.seg {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 78rpx;
  border: 2rpx solid #d8dee5;
  border-radius: 8rpx;
  background: #ffffff;
  color: #17212b;
  font-weight: 800;
}

.seg.active {
  border-color: #0b7a75;
  background: #e8f4f3;
  color: #0b7a75;
}

.score-row {
  display: grid;
  grid-template-columns: 1fr 42rpx 1fr;
  align-items: center;
  gap: 16rpx;
}

.score-input,
.text-input {
  height: 88rpx;
  border: 2rpx solid #d8dee5;
  border-radius: 8rpx;
  background: #ffffff;
  color: #17212b;
  font-size: 30rpx;
  font-weight: 800;
  text-align: center;
}

.score-colon {
  color: #68717d;
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
}

.text-input {
  padding: 0 24rpx;
  text-align: left;
  font-weight: 600;
}

.lineup-card {
  margin-bottom: 16rpx;
  padding: 22rpx;
}

.lineup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.lineup-title,
.lineup-status,
.lineup-empty {
  display: block;
}

.lineup-title {
  color: #17212b;
  font-size: 28rpx;
  font-weight: 900;
}

.lineup-status,
.lineup-empty {
  margin-top: 6rpx;
  color: #68717d;
  font-size: 23rpx;
  line-height: 1.4;
}

.lineup-refresh {
  flex: 0 0 104rpx;
  height: 58rpx;
  border: 2rpx solid #d8dee5;
  border-radius: 8rpx;
  background: #ffffff;
  color: #0b7a75;
  font-size: 24rpx;
  font-weight: 800;
}

.lineup-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.player-chip {
  min-width: 0;
  padding: 14rpx 16rpx;
  border: 2rpx solid #eef1f4;
  border-radius: 8rpx;
  background: #fbfcfd;
}

.player-chip.active {
  border-color: #0b7a75;
  background: #e8f4f3;
}

.player-name,
.player-meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-name {
  color: #17212b;
  font-size: 26rpx;
  font-weight: 900;
}

.player-meta {
  margin-top: 4rpx;
  color: #68717d;
  font-size: 21rpx;
}

.confidence-card {
  padding: 18rpx 22rpx;
  border-radius: 8rpx;
  background: #ffffff;
}

.confidence-card text {
  display: block;
  margin-bottom: 4rpx;
  color: #0b7a75;
  font-size: 34rpx;
  font-weight: 900;
}

.submit {
  margin-top: 38rpx;
}

.share {
  margin-top: 16rpx;
}

.ai-card {
  margin-top: 24rpx;
  padding: 26rpx;
}

.fun-card {
  margin-top: 24rpx;
  padding: 26rpx;
  background: #fff8ea;
}

.fun-title,
.fun-line {
  display: block;
}

.fun-title {
  color: #7a4b00;
  font-size: 30rpx;
  font-weight: 900;
}

.fun-line {
  margin: 12rpx 0 8rpx;
  color: #17212b;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.fun-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 14rpx 0 10rpx;
}

.fun-tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #7a4b00;
  font-size: 22rpx;
  font-weight: 800;
}

.ai-title,
.ai-score {
  display: block;
}

.ai-title {
  font-size: 30rpx;
  font-weight: 800;
}

.ai-score {
  margin: 14rpx 0 8rpx;
  color: #0b7a75;
  font-size: 34rpx;
  font-weight: 800;
}
