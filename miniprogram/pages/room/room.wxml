<view class="page">
  <view class="hero">
    <text class="hero-title">好友小组</text>
    <text class="hero-subtitle">把小组发给好友，每场比赛一起记录预测。</text>
  </view>

  <view class="toolbar">
    <button class="primary-btn create-btn" bindtap="createRoom">创建小组</button>
  </view>

  <view class="create-modal-mask" wx:if="{{showCreateModal}}" bindtap="closeCreateModal"></view>
  <view class="create-modal" wx:if="{{showCreateModal}}">
    <text class="modal-title">创建小组</text>
    <input
      class="modal-input"
      value="{{createName}}"
      placeholder="输入小组名称"
      maxlength="24"
      bindinput="onCreateNameInput"
    />
    <view class="visibility-box">
      <label class="visibility-label">
        <checkbox checked="{{createIsPublic}}" bindchange="onToggleCreatePublic"></checkbox>
        <text>公开小组</text>
      </label>
      <text class="muted">未勾选时默认为私密，未加入成员看不到该小组</text>
    </view>
    <view class="modal-actions">
      <button class="ghost-btn" bindtap="closeCreateModal">取消</button>
      <button class="primary-btn" bindtap="confirmCreateRoom">确认创建</button>
    </view>
  </view>

  <view class="room-list">
    <view class="card room-card" wx:for="{{rooms}}" wx:key="id">
      <view class="room-head">
        <view>
          <text class="room-name">{{item.name}}</text>
          <text class="muted">{{item.type || (item.isPublic ? "公开" : "私密")}} · {{item.members}} 人 · {{item.joined ? "已加入" : "未加入"}}</text>
        </view>
        <view wx:if="{{item.canManage}}" class="manage-actions">
          <button
            class="mini-btn"
            bindtap="editRoom"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            data-topic="{{item.topic}}"
            data-type="{{item.type}}"
          >改名</button>
          <button class="mini-btn danger-btn" bindtap="deleteRoom" data-id="{{item.id}}">删除</button>
        </view>
      </view>

      <view class="topic">
        <text class="topic-label">小组话题</text>
        <text>{{item.topic || '可邀请成员一起记录预测，关注每场比赛的赛果。'}}</text>
      </view>

      <view class="heat">
        <view class="heat-head">
          <text>房间热度</text>
          <text>{{item.heat}}%</text>
        </view>
        <view class="heat-track">
          <view class="heat-fill" style="width: {{item.heat}}%;"></view>
        </view>
      </view>

      <view class="highlight-grid">
        <view class="highlight-item" wx:for="{{item.highlights}}" wx:for-item="highlight" wx:key="title">
          <text class="highlight-title">{{highlight.title}}</text>
          <text class="highlight-value">{{highlight.value}}</text>
          <text class="highlight-note">{{highlight.note}}</text>
        </view>
      </view>

      <view class="rank-list">
        <view class="{{player.isMe ? 'rank-row me' : 'rank-row'}}" wx:for="{{item.players}}" wx:for-item="player" wx:for-index="index" wx:key="id">
          <text class="rank-no">{{index + 1}}</text>
          <text class="rank-name">{{player.name}}</text>
          <text class="rank-score">{{player.score}} 分</text>
        </view>
      </view>

      <view class="{{item.joined ? 'room-actions joined-actions' : 'room-actions'}}">
        <button class="ghost-btn cheer-btn" bindtap="cheerRoom" data-id="{{item.id}}">助威 {{item.cheers}}</button>
        <button
          wx:if="{{!item.joined}}"
          class="primary-btn join-btn"
          loading="{{actionRoomId === item.id}}"
          bindtap="joinRoom"
          data-id="{{item.id}}"
        >加入小组</button>
        <button class="ghost-btn share-btn" open-type="share" data-id="{{item.id}}" data-room="{{item.name}}">邀请成员</button>
      </view>
    </view>
  </view>
</view>
