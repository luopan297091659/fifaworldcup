.toolbar {
  margin-top: 24rpx;
}

.create-btn {
  width: 100%;
}

.room-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 28rpx;
}

.room-card {
  padding: 26rpx;
}

.room-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.room-name {
  display: block;
  margin-bottom: 8rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.sponsor {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #fff4df;
  color: #7a4b00;
  font-size: 24rpx;
  font-weight: 700;
}

.manage-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 10rpx;
}

.mini-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border: 2rpx solid #d8dee5;
  border-radius: 8rpx;
  background: #ffffff;
  color: #17212b;
  font-size: 23rpx;
  font-weight: 800;
}

.danger-btn {
  border-color: #f0c8bd;
  color: #b64128;
}

.topic {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f4f6f8;
  color: #17212b;
  font-size: 24rpx;
  line-height: 1.45;
}

.topic-label {
  flex: 0 0 auto;
  color: #0b7a75;
  font-weight: 900;
}

.heat {
  margin-top: 20rpx;
}

.heat-head {
  display: flex;
  justify-content: space-between;
  color: #68717d;
  font-size: 24rpx;
  font-weight: 800;
}

.heat-track {
  height: 14rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e6ebef;
}

.heat-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #0b7a75;
}

.highlight-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.highlight-item {
  min-width: 0;
  padding: 16rpx 12rpx;
  border: 2rpx solid #eef1f4;
  border-radius: 8rpx;
  background: #fbfcfd;
}

.highlight-title,
.highlight-value,
.highlight-note {
  display: block;
}

.highlight-title {
  color: #68717d;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.25;
}

.highlight-value {
  margin-top: 8rpx;
  overflow: hidden;
  color: #17212b;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.highlight-note {
  margin-top: 6rpx;
  color: #8a949f;
  font-size: 20rpx;
  line-height: 1.3;
}

.rank-list {
  margin-top: 22rpx;
}

.rank-row {
  display: grid;
  grid-template-columns: 52rpx 1fr 130rpx;
  align-items: center;
  min-height: 64rpx;
  border-top: 2rpx solid #eef1f4;
}

.rank-row:first-child {
  border-top: none;
}

.rank-row.me {
  color: #0b7a75;
  font-weight: 800;
}

.rank-no {
  color: #8a949f;
  font-weight: 800;
}

.rank-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-score {
  text-align: right;
  font-weight: 800;
}

.room-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.joined-actions {
  justify-content: space-between;
}

.cheer-btn,
.join-btn,
.share-btn {
  flex: 1 1 180rpx;
  min-width: 0;
  height: auto;
  min-height: 78rpx;
  padding: 10rpx 12rpx;
  line-height: 1.2;
  white-space: normal;
}

.join-btn,
.share-btn {
  flex-basis: 220rpx;
}

.cheer-btn {
  flex-basis: 150rpx;
}
