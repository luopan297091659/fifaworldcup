page {
  min-height: 100vh;
  background: #f4f6f8;
  color: #17212b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
picker {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  line-height: 1.2;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
}

.hero {
  padding: 36rpx 32rpx;
  border-radius: 8rpx;
  background: #101820;
  color: #ffffff;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.18;
}

.hero-subtitle {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 26rpx;
  line-height: 1.5;
}

.section-title {
  margin: 34rpx 0 18rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.card {
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 32, 0.06);
}

.muted {
  color: #68717d;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  border-radius: 8rpx;
  background: #0b7a75;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 78rpx;
  border: 2rpx solid #d8dee5;
  border-radius: 8rpx;
  background: #ffffff;
  color: #17212b;
  font-size: 27rpx;
  font-weight: 700;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #e8f4f3;
  color: #0b7a75;
  font-size: 22rpx;
  font-weight: 700;
}

.danger {
  color: #b64128;
}
